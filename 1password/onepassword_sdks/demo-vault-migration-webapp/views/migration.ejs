<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vault Migration | 1Password</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #0f1419;
      --bg-secondary: #161c26;
      --bg-tertiary: #1e2532;
      --bg-elevated: #273042;
      --accent-primary: #5b9bd5;
      --accent-secondary: #7eb5d6;
      --accent-success: #6ab187;
      --accent-warning: #d4a574;
      --accent-error: #d47a7a;
      --accent-tint: rgba(91, 155, 213, 0.12);
      --success-tint: rgba(106, 177, 135, 0.14);
      --warning-tint: rgba(212, 165, 116, 0.14);
      --error-tint: rgba(212, 122, 122, 0.14);
      --text-primary: #e4e7ed;
      --text-secondary: #a8afc0;
      --text-tertiary: #737b8f;
      --text-muted: #4d5361;
      --border-subtle: #232a37;
      --border-normal: #2f3747;
      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 6px 18px rgba(0, 0, 0, 0.35);
      --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.45);
      --radius: 14px;
      --space-xs: 0.25rem;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2rem;
      --font-sans: 'IBM Plex Sans', -apple-system, system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', 'Courier New', monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.55;
      min-height: 100vh;
      overflow-x: hidden;
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(900px 500px at 10% -10%, rgba(91, 155, 213, 0.10), transparent 60%),
        radial-gradient(700px 400px at 100% 110%, rgba(106, 177, 135, 0.06), transparent 60%);
      pointer-events: none;
      z-index: 0;
    }
    .container { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: var(--space-xl) var(--space-xl) 0; }

    /* Top bar: title on the left, connection status on the right once connected */
    .header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); flex-wrap: wrap; margin-bottom: var(--space-xl); }
    .brand { display: flex; align-items: center; gap: 0.85rem; }
    .brand-mark {
      width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-size: 1.3rem;
      background: linear-gradient(135deg, rgba(91, 155, 213, 0.28), rgba(91, 155, 213, 0.08));
      border: 1px solid rgba(91, 155, 213, 0.35);
    }
    .header h1 { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
    .header p { color: var(--text-tertiary); font-size: 0.85rem; }

    .status-banner {
      display: none; align-items: center; gap: var(--space-md);
      background: var(--bg-secondary); border: 1px solid var(--border-normal); border-radius: 999px;
      padding: 6px 6px 6px 14px; box-shadow: var(--shadow-sm);
    }
    .status-banner.active { display: flex; }
    .conn-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-success); box-shadow: 0 0 0 4px var(--success-tint); flex-shrink: 0; }
    .conn-route { display: flex; align-items: center; gap: var(--space-sm); font-size: 0.82rem; color: var(--text-secondary); min-width: 0; }
    .conn-route strong { color: var(--text-primary); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
    .conn-route .arrow { color: var(--text-tertiary); }
    .conn-mode { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-tertiary); border-left: 1px solid var(--border-normal); padding-left: var(--space-md); white-space: nowrap; }

    /* Connection form */
    .card {
      background: var(--bg-secondary); border: 1px solid var(--border-normal); border-radius: var(--radius);
      padding: var(--space-xl); margin-bottom: var(--space-xl); box-shadow: var(--shadow-md);
      max-width: 720px;
    }
    .card h2 { font-size: 1.2rem; font-weight: 600; margin-bottom: var(--space-xs); }
    .card .subtitle { color: var(--text-tertiary); font-size: 0.9rem; margin-bottom: var(--space-lg); }
    .form-group { margin-bottom: var(--space-lg); }
    .form-group label { display: block; font-size: 0.78rem; font-weight: 500; color: var(--text-secondary); margin-bottom: var(--space-sm); text-transform: uppercase; letter-spacing: 0.05em; }
    .form-group input {
      width: 100%; padding: 0.8rem var(--space-md); background: var(--bg-tertiary); border: 1px solid var(--border-normal);
      border-radius: 10px; color: var(--text-primary); font-family: var(--font-mono); font-size: 0.9rem; transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-group input::placeholder { color: var(--text-muted); }
    .help-text { font-size: 0.8rem; color: var(--text-tertiary); line-height: 1.6; margin-bottom: var(--space-lg); }
    .desktop-note { padding: 12px 16px; background: var(--warning-tint); border: 1px solid rgba(212, 165, 116, 0.4); border-radius: 10px; margin-bottom: var(--space-lg); font-size: 0.85rem; color: var(--text-secondary); }

    input:focus-visible, .btn:focus-visible { outline: none; border-color: var(--accent-primary); box-shadow: 0 0 0 3px rgba(91, 155, 213, 0.25); }

    /* Buttons */
    .btn {
      padding: 0.65rem 1.15rem; border: 1px solid transparent; border-radius: 10px; font-size: 0.88rem; font-weight: 500;
      font-family: var(--font-sans); cursor: pointer; transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
      display: inline-flex; align-items: center; justify-content: center; gap: var(--space-sm); text-decoration: none; white-space: nowrap; color: var(--text-primary);
    }
    .btn svg { width: 16px; height: 16px; flex-shrink: 0; }
    .btn-primary { background: var(--accent-primary); color: #0b1220; font-weight: 600; box-shadow: 0 4px 14px rgba(91, 155, 213, 0.25); }
    .btn-primary:hover:not(:disabled) { background: var(--accent-secondary); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(91, 155, 213, 0.35); }
    .btn-primary .spinner { border-color: rgba(11, 18, 32, 0.25); border-top-color: #0b1220; }
    .btn-secondary { background: var(--bg-elevated); border-color: var(--border-normal); }
    .btn-secondary:hover:not(:disabled) { border-color: var(--accent-primary); }
    .btn-ghost { background: transparent; border-color: var(--border-normal); color: var(--text-secondary); }
    .btn-ghost:hover:not(:disabled) { background: var(--bg-tertiary); color: var(--text-primary); }
    .btn-sm { padding: 0.4rem 0.85rem; font-size: 0.8rem; border-radius: 999px; }
    .btn-lg { padding: 0.8rem 1.6rem; font-size: 0.95rem; }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
    .spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid var(--text-muted); border-top-color: var(--accent-primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Connected view */
    .vault-container { display: none; padding-bottom: 110px; }
    .vault-container.active { display: block; animation: fadeUp 0.3s ease; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); margin-bottom: var(--space-lg); }
    .stat { background: var(--bg-secondary); border: 1px solid var(--border-normal); border-radius: var(--radius); padding: var(--space-md) var(--space-lg); }
    .stat-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-tertiary); }
    .stat-value { font-size: 1.6rem; font-weight: 600; font-family: var(--font-mono); line-height: 1.3; margin-top: 2px; }
    .stat-value.accent { color: var(--accent-primary); }
    .stat-sub { font-size: 0.78rem; color: var(--text-tertiary); }

    .panel { background: var(--bg-secondary); border: 1px solid var(--border-normal); border-radius: var(--radius); box-shadow: var(--shadow-md); overflow: hidden; }
    .toolbar { display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-md); border-bottom: 1px solid var(--border-normal); flex-wrap: wrap; }
    .field { position: relative; display: flex; align-items: center; }
    .field svg { position: absolute; left: 12px; width: 16px; height: 16px; color: var(--text-tertiary); pointer-events: none; }
    .field input {
      width: 100%; padding: 0.6rem 0.8rem 0.6rem 36px; background: var(--bg-tertiary); border: 1px solid var(--border-normal);
      border-radius: 10px; color: var(--text-primary); font-size: 0.88rem; font-family: var(--font-sans);
    }
    .field input::placeholder { color: var(--text-tertiary); }
    .field.search { flex: 1 1 260px; }
    .field.suffix { flex: 0 1 260px; }
    .toolbar-spacer { flex: 1; }

    .debug-toggle {
      display: inline-flex; align-items: center; gap: var(--space-sm); padding: 0.45rem 0.75rem;
      border: 1px solid var(--border-normal); border-radius: 10px; cursor: pointer; user-select: none; transition: all 0.15s ease;
    }
    .debug-toggle:hover { background: var(--bg-tertiary); }
    .debug-toggle.active { border-color: rgba(212, 165, 116, 0.6); background: var(--warning-tint); }
    .debug-toggle-label { font-size: 0.8rem; font-weight: 500; color: var(--text-secondary); }
    .debug-toggle.active .debug-toggle-label { color: var(--accent-warning); }
    .debug-switch { position: relative; width: 30px; height: 17px; flex-shrink: 0; }
    .debug-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
    .debug-slider { position: absolute; cursor: pointer; inset: 0; background-color: var(--border-normal); border-radius: 17px; transition: 0.2s; }
    .debug-slider::before { content: ""; position: absolute; height: 11px; width: 11px; left: 3px; bottom: 3px; background-color: var(--text-tertiary); border-radius: 50%; transition: 0.2s; }
    .debug-switch input:checked + .debug-slider { background-color: var(--accent-warning); }
    .debug-switch input:checked + .debug-slider::before { transform: translateX(13px); background-color: white; }

    .vault-table-container { overflow-x: auto; }
    .vault-table { width: 100%; border-collapse: collapse; }
    .vault-table th {
      padding: 0.7rem var(--space-md); text-align: left; font-size: 0.72rem; font-weight: 600; color: var(--text-tertiary);
      text-transform: uppercase; letter-spacing: 0.06em; background: var(--bg-tertiary); border-bottom: 1px solid var(--border-normal); white-space: nowrap;
    }
    .vault-table td { padding: 0.8rem var(--space-md); border-bottom: 1px solid var(--border-subtle); font-size: 0.9rem; vertical-align: middle; }
    .vault-table th.num, .vault-table td.num { text-align: right; }
    .vault-table .cell-check { width: 48px; padding-right: 0; }
    .vault-table tbody tr:last-child td { border-bottom: none; }
    .vault-table tbody tr { transition: background 0.15s ease; box-shadow: inset 3px 0 0 transparent; }
    .vault-table tbody tr:hover { background: rgba(255, 255, 255, 0.02); }
    .vault-table tbody tr.selected { background: var(--accent-tint); box-shadow: inset 3px 0 0 var(--accent-primary); }
    .vault-table tbody tr.row-disabled { opacity: 0.5; }
    .vault-name { font-weight: 500; color: var(--text-primary); word-break: break-word; }
    .vault-id { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-tertiary); margin-top: 1px; }
    .item-count { font-family: var(--font-mono); color: var(--text-primary); font-weight: 500; }
    .suffix-input {
      width: 130px; padding: 0.35rem 0.6rem; background: transparent; border: 1px solid var(--border-normal); border-radius: 8px;
      color: var(--text-primary); font-size: 0.8rem; font-family: var(--font-sans);
    }
    .suffix-input::placeholder { color: var(--text-muted); }
    .suffix-input:disabled { opacity: 0.5; }
    .empty-row td { text-align: center; color: var(--text-tertiary); padding: var(--space-xl); }

    .status-badge {
      display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
      font-size: 0.76rem; font-weight: 500; white-space: nowrap; background: rgba(168, 175, 192, 0.1); color: var(--text-secondary);
    }
    .status-badge.pending { background: rgba(168, 175, 192, 0.1); color: var(--text-tertiary); }
    .status-badge.personal, .status-badge.preparing, .status-badge.warning { background: var(--warning-tint); color: var(--accent-warning); }
    .status-badge.migrating, .status-badge.type-personal { background: var(--accent-tint); color: var(--accent-primary); }
    .status-badge.success, .status-badge.type-shared { background: var(--success-tint); color: var(--accent-success); }
    .status-badge.error { background: var(--error-tint); color: var(--accent-error); }
    .status-badge .spinner-small { width: 11px; height: 11px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; }
    input[type="checkbox"] { width: 17px; height: 17px; cursor: pointer; accent-color: var(--accent-primary); vertical-align: middle; }
    input[type="checkbox"]:disabled { cursor: not-allowed; }

    /* Progress */
    .progress-container { display: none; padding: var(--space-lg); margin-bottom: var(--space-lg); }
    .progress-container.active { display: block; animation: fadeUp 0.25s ease; }
    .progress-header { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-md); margin-bottom: var(--space-md); }
    .eyebrow { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-tertiary); margin-bottom: 2px; }
    .progress-label { font-size: 0.92rem; color: var(--text-primary); font-weight: 500; }
    .progress-percentage { font-size: 1.9rem; line-height: 1; color: var(--accent-primary); font-weight: 600; font-family: var(--font-mono); }
    .progress-bar-outer { width: 100%; height: 10px; background: var(--bg-tertiary); border-radius: 999px; overflow: hidden; }
    .progress-bar-inner {
      position: relative; height: 100%; width: 0%; border-radius: 999px; overflow: hidden;
      background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary)); transition: width 0.4s ease;
    }
    .progress-bar-inner::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transform: translateX(-100%); animation: shimmer 1.6s ease-in-out infinite;
    }
    @keyframes shimmer { to { transform: translateX(100%); } }
    .progress-stats { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-md); font-size: 0.8rem; color: var(--text-tertiary); }
    .chip { display: inline-flex; gap: 6px; padding: 3px 10px; border-radius: 999px; background: var(--bg-tertiary); border: 1px solid var(--border-subtle); }
    .chip b { color: var(--text-primary); font-family: var(--font-mono); font-weight: 500; }
    .rate-usage { font-size: 0.75rem; color: var(--text-tertiary); margin-top: var(--space-sm); font-family: var(--font-mono); }
    .rate-usage:empty { display: none; }
    .rate-usage .near { color: var(--accent-warning); }
    .rate-pause { margin-top: var(--space-md); padding: var(--space-md); border-radius: 12px; border: 1px solid rgba(212, 165, 116, 0.5); background: var(--warning-tint); }
    .rate-pause-title { font-weight: 600; color: var(--accent-warning); margin-bottom: var(--space-xs); }
    .rate-pause-detail { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; }
    .rate-pause-countdown { font-family: var(--font-mono); font-size: 1.6rem; color: var(--text-primary); margin: var(--space-sm) 0; }
    .rate-pause-actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
    #rateLimitBanner { border-radius: 12px; }

    /* Messages */
    #alertContainer:empty { display: none; }
    #alertContainer { margin-bottom: var(--space-lg); display: grid; gap: var(--space-sm); }
    .alert {
      padding: 0.7rem var(--space-md); border-radius: 12px; display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.88rem;
      background: var(--bg-secondary); border: 1px solid var(--border-normal); color: var(--text-secondary);
      animation: slideIn 0.25s ease; transition: opacity 0.3s ease;
    }
    .alert-icon { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: 0.7rem; font-weight: 700; flex-shrink: 0; margin-top: 1px; }
    @keyframes slideIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    .alert-success { border-color: rgba(106, 177, 135, 0.45); } .alert-success .alert-icon { background: var(--success-tint); color: var(--accent-success); }
    .alert-error { border-color: rgba(212, 122, 122, 0.5); color: var(--accent-error); } .alert-error .alert-icon { background: var(--error-tint); color: var(--accent-error); }
    .alert-warning { border-color: rgba(212, 165, 116, 0.5); } .alert-warning .alert-icon { background: var(--warning-tint); color: var(--accent-warning); }
    .alert-info { border-color: rgba(91, 155, 213, 0.45); } .alert-info .alert-icon { background: var(--accent-tint); color: var(--accent-primary); }

    /* Summary */
    .migration-summary { display: none; padding: var(--space-lg); margin-top: var(--space-lg); }
    .migration-summary.active { display: block; animation: fadeUp 0.3s ease; }
    .summary-title { font-size: 1rem; font-weight: 600; margin-bottom: var(--space-md); }
    .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--space-md); }
    .summary-item { background: var(--bg-tertiary); padding: var(--space-md); border-radius: 12px; border: 1px solid var(--border-subtle); border-top: 3px solid var(--border-normal); }
    .summary-item label { display: block; font-size: 0.72rem; color: var(--text-tertiary); margin-bottom: var(--space-xs); text-transform: uppercase; letter-spacing: 0.06em; }
    .summary-item .value { font-size: 1.6rem; font-weight: 600; font-family: var(--font-mono); }
    .summary-item.success { border-top-color: var(--accent-success); } .summary-item.success .value { color: var(--accent-success); }
    .summary-item.error { border-top-color: var(--accent-error); } .summary-item.error .value { color: var(--accent-error); }
    .summary-item.info { border-top-color: var(--accent-primary); } .summary-item.info .value { color: var(--accent-primary); }

    /* Sticky bar with the selection and the Migrate Selected button */
    .action-bar {
      position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 10;
      width: min(1200px - 4rem, calc(100% - 2rem)); display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
      padding: 0.7rem 0.7rem 0.7rem 1.25rem; border-radius: 16px;
      background: rgba(22, 28, 38, 0.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-normal); box-shadow: var(--shadow-lg);
    }
    .vault-container:not(.active) .action-bar { display: none; }
    .action-progress { position: absolute; left: 14px; right: 14px; top: 0; height: 3px; border-radius: 0 0 3px 3px; overflow: hidden; display: none; }
    .action-progress div { height: 100%; width: 0; background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary)); transition: width 0.4s ease; }
    .action-bar.migrating .action-progress { display: block; }
    .action-bar.migrating .action-hint { max-width: 60ch; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* the toolbar and column headings stay at the top of the screen while the list scrolls */
    .panel.vault-panel { overflow: visible; }
    .vault-panel .toolbar { position: sticky; top: 0; z-index: 5; background: var(--bg-secondary); border-radius: var(--radius) var(--radius) 0 0; }
    .vault-panel .vault-table th { position: sticky; top: var(--toolbar-h, 0px); z-index: 4; }
    .vault-panel .vault-table-container { overflow: visible; border-radius: 0 0 var(--radius) var(--radius); }
    .action-count { font-weight: 600; font-size: 0.95rem; }
    .action-hint { display: block; font-size: 0.8rem; color: var(--text-tertiary); }
    .action-buttons { display: flex; gap: var(--space-sm); }

    @media (max-width: 860px) {
      .container { padding: var(--space-md) var(--space-md) 0; }
      .stats, .summary-grid { grid-template-columns: repeat(2, 1fr); }
      .status-banner { border-radius: 14px; flex-wrap: wrap; width: 100%; }
      .conn-mode { display: none; }
      .field.search, .field.suffix { flex: 1 1 100%; }
      .vault-table .col-suffix { display: none; }
      .vault-panel .vault-table-container { overflow-x: auto; }
      .vault-panel .toolbar { position: static; }
      .action-bar { bottom: 10px; padding: 0.75rem; flex-wrap: wrap; gap: var(--space-sm); }
      .action-buttons { width: 100%; }
      .action-buttons .btn { flex: 1; }
      .vault-container { padding-bottom: 150px; }
      .action-hint { display: none; }
    }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-primary); }
    ::-webkit-scrollbar-thumb { background: var(--border-normal); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--accent-primary); }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <div class="brand">
        <div class="brand-mark">🔐</div>
        <div>
          <h1>Vault Migration</h1>
          <p>Copy 1Password vaults from one account to another</p>
        </div>
      </div>

      <div class="status-banner" id="statusBanner">
        <span class="conn-dot" title="Connected"></span>
        <div class="conn-route">
          <strong id="connSource">Source</strong>
          <span class="arrow">→</span>
          <strong id="connDest">Destination</strong>
        </div>
        <span class="conn-mode" id="connMode">Service accounts</span>
        <button class="btn btn-ghost btn-sm" onclick="editConnection()">Edit connection</button>
      </div>
    </header>

    <div class="card" id="connectionCard">
      <h2>Connect to 1Password</h2>
      <p class="subtitle" id="connectionSubtitle">Enter your service account tokens to begin migration</p>

      <form id="connectionForm">
        <div id="serviceAccountFields">
          <div class="form-group">
            <label for="sourceToken">Source Account Token</label>
            <input type="password" id="sourceToken" name="sourceToken" placeholder="ops_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx">
          </div>

          <div class="form-group">
            <label for="destToken">Destination Account Token</label>
            <input type="password" id="destToken" name="destToken" placeholder="ops_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx">
          </div>
        </div>

        <div id="desktopAuthFields" style="display: none;">
          <div class="form-group">
            <label for="sourceAccountName">Source Account Name</label>
            <input type="text" id="sourceAccountName" name="sourceAccountName" placeholder="e.g. My Team">
          </div>

          <div class="form-group">
            <label for="destAccountName">Destination Account Name</label>
            <input type="text" id="destAccountName" name="destAccountName" placeholder="e.g. New Company">
          </div>

          <div class="desktop-note">
            ⚠️ Desktop auth requires the 1Password desktop app running locally. The CLI (<code>op</code>) must be installed for vault creation. Docker is <strong>not supported</strong>.
          </div>
        </div>

        <div class="help-text">
          Items with CUSTOM categories will be automatically converted to Login items during migration, preserving all fields and concealed values.
          Personal/Private vaults (Employee vaults) are skipped when using service accounts. Only shared vaults are migrated with "(Migrated)" appended to the name. With desktop auth, personal vault items are migrated to the destination's existing Private vault.
        </div>

        <button type="submit" class="btn btn-primary" id="connectBtn">
          <span id="connectBtnText">Connect Accounts</span>
          <span id="connectSpinner" style="display: none;" class="spinner"></span>
        </button>
      </form>

      <div id="connectionError"></div>
    </div>

    <div class="vault-container" id="vaultContainer">
      <div class="stats">
        <div class="stat"><div class="stat-label" id="statVaultsLabel">Vaults in source</div><div class="stat-value" id="vaultCount">0</div><div class="stat-sub" id="statVaultsSub"></div></div>
        <div class="stat"><div class="stat-label" id="statSourceItemsLabel">Items in source</div><div class="stat-value" id="statSourceItems">0</div><div class="stat-sub">across all vaults</div></div>
        <div class="stat"><div class="stat-label">Selected</div><div class="stat-value accent" id="statSelected">0</div><div class="stat-sub">vaults to migrate</div></div>
        <div class="stat"><div class="stat-label">Items to copy</div><div class="stat-value accent" id="statItems">0</div><div class="stat-sub">in the selected vaults</div></div>
      </div>

      <div id="rateLimitBanner" style="display: none; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1rem; line-height: 1.5;"></div>

      <div class="progress-container panel" id="progressContainer">
        <div class="progress-header">
          <div>
            <div class="eyebrow">Migration progress</div>
            <div class="progress-label" id="progressLabel">Preparing migration...</div>
          </div>
          <span class="progress-percentage" id="progressPercentage">0%</span>
        </div>
        <div class="progress-bar-outer">
          <div class="progress-bar-inner" id="progressBar"></div>
        </div>
        <div class="progress-stats" id="progressStats">
          <span class="chip">Vaults <b id="vaultsProgress">0/0</b></span>
          <span class="chip">Items <b id="itemsProgress">0/0</b></span>
        </div>
        <div class="rate-usage" id="rateUsage"></div>

        <div class="rate-pause" id="ratePausePanel" hidden>
          <div class="rate-pause-title">⏸ Paused to stay under the 1Password rate limit</div>
          <div class="rate-pause-detail" id="ratePauseDetail"></div>
          <div class="rate-pause-countdown" id="ratePauseCountdown" aria-live="polite">--:--</div>
          <div class="rate-pause-actions">
            <button class="btn btn-primary" id="rateResumeBtn" onclick="resumeMigration()" disabled>Resume</button>
            <button class="btn btn-secondary" id="rateCancelBtn" onclick="cancelMigration()">Cancel migration</button>
          </div>
        </div>
      </div>

      <div id="alertContainer"></div>

      <div class="panel vault-panel">
        <div class="toolbar">
          <label class="field search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="text" id="vaultSearch" placeholder="Search vaults by name or ID" oninput="filterVaults()" aria-label="Search vaults">
          </label>
          <label class="field suffix" title="Added to the name of every new vault that doesn't have its own suffix">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
            <input type="text" id="globalSuffix" placeholder="Suffix for all vaults (optional)" aria-label="Suffix for all vaults">
          </label>
          <div class="toolbar-spacer"></div>
          <div class="debug-toggle" id="debugToggle" onclick="toggleDebug()" title="Enable verbose debug logging for all items in migration logs">
            <label class="debug-switch">
              <input type="checkbox" id="debugCheckbox" onclick="event.stopPropagation()">
              <span class="debug-slider"></span>
            </label>
            <span class="debug-toggle-label">Debug logging</span>
          </div>
          <button class="btn btn-ghost" onclick="downloadLogs()" id="downloadLogsBtn" title="Download the migration log">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
            Logs
          </button>
        </div>

        <div class="vault-table-container">
          <table class="vault-table">
            <thead>
              <tr>
                <th class="cell-check"><input type="checkbox" id="selectAll" onchange="toggleSelectAll()" aria-label="Select all vaults"></th>
                <th>Vault</th>
                <th>Type</th>
                <th class="num">Items</th>
                <th class="col-suffix">Suffix</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="vaultTableBody"></tbody>
          </table>
        </div>
      </div>

      <div class="migration-summary panel" id="migrationSummary">
        <h3 class="summary-title">Migration summary</h3>
        <div class="summary-grid">
          <div class="summary-item success"><label>Items copied</label><div class="value" id="successCount">0</div></div>
          <div class="summary-item error"><label>Items failed</label><div class="value" id="failureCount">0</div></div>
          <div class="summary-item info"><label>Total items</label><div class="value" id="totalItems">0</div></div>
          <div class="summary-item info"><label>Vaults</label><div class="value" id="totalVaults">0</div></div>
        </div>
      </div>

      <div class="action-bar">
        <div class="action-progress"><div id="actionProgressBar"></div></div>
        <div>
          <span class="action-count" id="vaultSelectionCount">No vaults selected</span>
          <span class="action-hint" id="selectionHint">Pick the vaults to copy to the destination</span>
        </div>
        <div class="action-buttons">
          <button class="btn btn-ghost" onclick="showAllVaults()" id="showAllVaultsBtn" style="display: none;">Show all vaults</button>
          <button class="btn btn-primary btn-lg" onclick="migrateSelected()" id="migrateSelectedBtn">Migrate Selected</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let vaults = [];
    let selectedVaultIds = new Set();
    let isMigrating = false;
    let sourceToken = '';
    let destToken = '';
    let authMode = 'service-account';
    let sourceAccountName = '';
    let destAccountName = '';
    let totalVaultsToMigrate = 0;
    let completedVaults = 0;
    let totalItemsToMigrate = 0;
    let processedItems = 0;
    let completedItemsFromPriorVaults = 0;
    let migratedVaultIds = new Set();
    let currentMigrationId = null;
    let pauseCountdownTimer = null;
    const rateUsageByLabel = {};

    // Set when the page picked up a migration after a refresh: it has no tokens, so it has to connect
    // again before it can start another migration.
    let needsReconnect = false;

    
    const urlParams = new URLSearchParams(window.location.search);
    authMode = urlParams.get('authMode') || 'service-account';
    const useEnv = urlParams.get('useEnv') === 'true';
    // Switches off if the user ends up typing tokens in by hand.
    let usingEnv = useEnv;

    
    document.addEventListener('DOMContentLoaded', async () => {
      initStickyToolbar();
      const reattached = await reattachToRunningMigration();
      if (useEnv) {
        document.getElementById('serviceAccountFields').style.display = 'none';
        document.getElementById('desktopAuthFields').style.display = 'none';
        document.getElementById('connectionSubtitle').textContent = 'Connecting from .env...';
        if (!reattached) autoConnectWithEnv();
      } else if (authMode === 'desktop') {
        document.getElementById('serviceAccountFields').style.display = 'none';
        document.getElementById('desktopAuthFields').style.display = 'block';
        document.getElementById('connectionSubtitle').textContent = 'Connect using 1Password desktop app integration';
      }
    });

    async function autoConnectWithEnv() {
      const connectBtn = document.getElementById('connectBtn');
      const connectBtnText = document.getElementById('connectBtnText');
      const connectSpinner = document.getElementById('connectSpinner');
      const errorDiv = document.getElementById('connectionError');
      const subtitle = document.getElementById('connectionSubtitle');

      
      document.getElementById('serviceAccountFields').style.display = 'none';
      document.getElementById('desktopAuthFields').style.display = 'none';
      connectBtn.disabled = true;
      connectBtnText.textContent = 'Connecting from .env...';
      connectSpinner.style.display = 'inline-block';
      if (subtitle) subtitle.textContent = 'Verifying .env credentials...';

      try {
        
        const envRes = await fetch('/migration/env-status');
        const envData = await envRes.json();

        if (!envData.loaded || !envData.ready) {
          usingEnv = false;
          document.getElementById('serviceAccountFields').style.display = 'block';
          if (subtitle) subtitle.textContent = '.env not found or incomplete. Enter tokens manually';
          connectBtnText.textContent = 'Connect Accounts';
          connectBtn.disabled = false;
          connectSpinner.style.display = 'none';
          errorDiv.innerHTML = '<div class="alert alert-warning"><span>⚠️</span><span>.env file not loaded or missing required variables. Enter credentials manually.</span></div>';
          return;
        }

        
        if (envData.authMode === 'desktop') {
          authMode = 'desktop';
        }

        const modeLabel = envData.authMode === 'desktop' ? 'desktop auth' : 'service account';
        connectBtnText.textContent = 'Gathering vault details...';
        if (subtitle) subtitle.textContent = `✓ Connected via ${modeLabel}, collecting vault information`;

        await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));

        const response = await fetch('/migration/list-vaults', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ useEnvTokens: true })
        });
        const result = await response.json();
        if (result.success) {
          vaults = result.vaults;
          showVaultList();
          
          connectBtn.style.display = 'none';
          connectSpinner.style.display = 'none';
          const personalCount = vaults.filter(v => v.vaultType === 'personal').length;
          const sharedCount = vaults.length - personalCount;
          const displayLabel = envData.authMode === 'desktop' ? 'desktop auth' : '1Password Environments';
          let msg = `✓ Connected via ${displayLabel}! Found ${vaults.length} vaults`;
          if (personalCount > 0 && authMode === 'desktop') {
            msg += ` (${sharedCount} shared, ${personalCount} personal; personal vault items will go into the existing Private vault)`;
          } else if (personalCount > 0) {
            msg += ` (${sharedCount} shared, ${personalCount} personal; personal vaults will be skipped)`;
          }
          showAlert('success', msg);
        } else {
          throw new Error(result.error || 'Failed to connect');
        }
      } catch (error) {
        usingEnv = false;
        document.getElementById('serviceAccountFields').style.display = 'block';
        if (subtitle) subtitle.textContent = 'Auto-connect failed. Enter tokens manually';
        connectBtnText.textContent = 'Connect Accounts';
        connectBtn.disabled = false;
        connectSpinner.style.display = 'none';
        const errEl = document.createElement('div'); errEl.className = 'alert alert-error'; errEl.textContent = '⚠️ Failed to connect with .env: ' + error.message; errorDiv.innerHTML = ''; errorDiv.appendChild(errEl);
      }
    }
    
    document.getElementById('connectionForm').addEventListener('submit', handleConnect);

    
    async function initDebugToggle() {
      try {
        const res = await fetch('/migration/debug');
        const data = await res.json();
        applyDebugState(data.enabled);
      } catch (e) {
        console.warn('Could not fetch debug state:', e);
      }
    }

    async function toggleDebug() {
      const checkbox = document.getElementById('debugCheckbox');
      const newState = !checkbox.checked;
      try {
        const res = await fetch('/migration/debug', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ enabled: newState })
        });
        const data = await res.json();
        applyDebugState(data.enabled);
        showAlert('info', `🔧 Debug logging ${data.enabled ? 'enabled' : 'disabled'}`);
      } catch (e) {
        console.error('Failed to toggle debug:', e);
        showAlert('error', '✗ Failed to toggle debug mode');
      }
    }

    function applyDebugState(enabled) {
      const checkbox = document.getElementById('debugCheckbox');
      const toggle = document.getElementById('debugToggle');
      checkbox.checked = enabled;
      if (enabled) {
        toggle.classList.add('active');
      } else {
        toggle.classList.remove('active');
      }
    }

    initDebugToggle();
    
    async function handleConnect(e) {
      e.preventDefault();
      usingEnv = false;
      const connectBtn = document.getElementById('connectBtn');
      const connectBtnText = document.getElementById('connectBtnText');
      const connectSpinner = document.getElementById('connectSpinner');
      const errorDiv = document.getElementById('connectionError');
      const subtitle = document.getElementById('connectionSubtitle');
      
      if (authMode === 'desktop') {
        sourceAccountName = document.getElementById('sourceAccountName').value;
        destAccountName = document.getElementById('destAccountName').value;
        if (!sourceAccountName) {
          errorDiv.innerHTML = '<div class="alert alert-error"><span>⚠️</span><span>Source account name is required</span></div>';
          return;
        }
      } else {
        sourceToken = document.getElementById('sourceToken').value;
        destToken = document.getElementById('destToken').value;
      }
      
      connectBtn.disabled = true;
      connectBtnText.style.display = 'none';
      connectSpinner.style.display = 'inline-block';
      errorDiv.innerHTML = '';
      if (subtitle) subtitle.textContent = 'Connecting to 1Password...';
      
      try {
        const body = authMode === 'desktop'
          ? { authMode: 'desktop', sourceAccountName }
          : { serviceToken: sourceToken };

        if (subtitle) subtitle.textContent = 'Connected, collecting vault details...';

        await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));

        const response = await fetch('/migration/list-vaults', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const result = await response.json();
        if (result.success) {
          vaults = result.vaults;
          showVaultList();
          const personalCount = vaults.filter(v => v.vaultType === 'personal').length;
          const sharedCount = vaults.length - personalCount;
          let msg = `✓ Successfully connected! Found ${vaults.length} vaults`;
          if (personalCount > 0) {
            msg += ` (${sharedCount} shared, ${personalCount} personal; personal vaults will be skipped)`;
          }
          showAlert('success', msg);
        } else {
          throw new Error(result.error || 'Failed to connect');
        }
      } catch (error) {
        const errEl2 = document.createElement('div'); errEl2.className = 'alert alert-error'; errEl2.textContent = '⚠️ Failed to connect: ' + error.message; errorDiv.innerHTML = ''; errorDiv.appendChild(errEl2);
        if (subtitle) subtitle.textContent = 'Connection failed. Check your credentials and try again';
      } finally {
        connectBtn.disabled = false;
        connectBtnText.style.display = 'inline';
        connectSpinner.style.display = 'none';
      }
    }
    
    function showVaultList() {
      needsReconnect = false;
      resetVaultView();
      document.getElementById('connectionCard').style.display = 'none';
      document.getElementById('statusBanner').classList.add('active');
      document.getElementById('vaultContainer').classList.add('active');
      document.getElementById('vaultCount').textContent = vaults.length;
      const personal = vaults.filter(v => v.vaultType === 'personal').length;
      document.getElementById('statVaultsSub').textContent = personal === 0 ? 'all shared'
        : `${vaults.length - personal} shared, ${personal} personal${authMode === 'desktop' ? '' : ' (skipped)'}`;
      document.getElementById('statSourceItems').textContent = vaults.reduce((n, v) => n + (v.itemCount || 0), 0).toLocaleString();
      document.getElementById('statVaultsLabel').textContent = 'Vaults in source';
      document.getElementById('statSourceItemsLabel').textContent = 'Items in source';
      const desktop = authMode === 'desktop';
      document.getElementById('connSource').textContent = desktop ? (sourceAccountName || 'Source account') : 'Source';
      document.getElementById('connDest').textContent = desktop ? (destAccountName || 'Destination account') : 'Destination';
      document.getElementById('connMode').textContent = desktop ? 'Desktop app' : 'Service accounts';
      renderVaults();
      updateSelectionCount();
    }
    
    // New connection, new vaults, so clear the old selection and filters.
    function resetVaultView() {
      selectedVaultIds.clear();
      totalItemsToMigrate = 0;
      showSelectedOnly = false;
      document.getElementById('showAllVaultsBtn').style.display = 'none';
      document.getElementById('vaultSearch').value = '';
      const selectAll = document.getElementById('selectAll');
      selectAll.checked = false;
      selectAll.indeterminate = false;
      document.getElementById('vaultTableBody').innerHTML = '';
    }

    function editConnection() {
      if (isMigrating) {
        showAlert('warning', '⚠️ Wait for the migration to finish (or cancel it) before changing the connection');
        return;
      }
      document.getElementById('connectionCard').style.display = 'block';
      document.getElementById('statusBanner').classList.remove('active');
      document.getElementById('vaultContainer').classList.remove('active');
    }
    
    let showSelectedOnly = false;

    function renderVaults() {
      const tbody = document.getElementById('vaultTableBody');
      const searchTerm = document.getElementById('vaultSearch').value.toLowerCase();
      let filteredVaults = vaults.filter(v => v.name.toLowerCase().includes(searchTerm) || v.id.toLowerCase().includes(searchTerm));
      
      if (showSelectedOnly) {
        filteredVaults = filteredVaults.filter(v => selectedVaultIds.has(v.id));
      } else {
        filteredVaults.sort((a, b) => {
          const aSelected = selectedVaultIds.has(a.id) ? 0 : 1;
          const bSelected = selectedVaultIds.has(b.id) ? 0 : 1;
          if (aSelected !== bSelected) return aSelected - bSelected;
          const aMigrated = migratedVaultIds.has(a.id) ? 0 : 1;
          const bMigrated = migratedVaultIds.has(b.id) ? 0 : 1;
          if (aMigrated !== bMigrated) return aMigrated - bMigrated;
          return a.name.localeCompare(b.name);
        });
      }
      
      tbody.innerHTML = filteredVaults.map(vault => {
        const isPersonal = vault.vaultType === 'personal';
        const isDesktop = authMode === 'desktop';
        const personalDisabled = isPersonal && !isDesktop;
        const wasMigrated = migratedVaultIds.has(vault.id);
        const statusId = `status-${vault.id}`;
        const existingStatus = document.getElementById(statusId);
        const currentStatusHtml = existingStatus && existingStatus.innerHTML !== 'Pending'
          ? existingStatus.outerHTML
          : `<span class="status-badge ${personalDisabled ? 'personal' : (wasMigrated ? 'success' : 'pending')}" id="${statusId}">${personalDisabled ? 'Skipped' : (wasMigrated ? '✓ Migrated' : 'Pending')}</span>`;

        const rowClass = [selectedVaultIds.has(vault.id) ? 'selected' : '', personalDisabled ? 'row-disabled' : ''].join(' ').trim();
        const typeBadge = isPersonal
          ? `<span class="status-badge ${isDesktop ? 'type-personal' : 'personal'}">Personal</span>`
          : '<span class="status-badge type-shared">Shared</span>';

        return `
          <tr data-vault-id="${vault.id}" class="${rowClass}">
            <td class="cell-check">
              <input type="checkbox" class="vault-checkbox" value="${vault.id}" data-item-count="${vault.itemCount}"
                onchange="handleVaultSelection('${vault.id}', ${vault.itemCount})" aria-label="Select ${escapeHtml(vault.name)}"
                ${selectedVaultIds.has(vault.id) ? 'checked' : ''} ${isMigrating || personalDisabled ? 'disabled' : ''}
                title="${personalDisabled ? 'Personal vaults cannot be migrated with service accounts' : (wasMigrated ? 'Already migrated this session. Migrating it again will create duplicates' : '')}">
            </td>
            <td>
              <div class="vault-name">${escapeHtml(vault.name)}</div>
              <div class="vault-id">${vault.id}</div>
            </td>
            <td>${typeBadge}</td>
            <td class="item-count num">${Number(vault.itemCount).toLocaleString()}</td>
            <td class="col-suffix">
              <input type="text" class="suffix-input" placeholder="optional" aria-label="Suffix for ${escapeHtml(vault.name)}"
                value="${escapeHtml(vault.suffix || '')}"
                onchange="vaults.find(v=>v.id==='${vault.id}').suffix = this.value.trim()"
                ${isMigrating || personalDisabled ? 'disabled' : ''}>
            </td>
            <td>${currentStatusHtml}</td>
          </tr>
        `;
      }).join('') || '<tr class="empty-row"><td colspan="6">No vaults match your search</td></tr>';
    }
    
    function filterVaults() { renderVaults(); updateSelectionCount(); }

    function showAllVaults() {
      showSelectedOnly = false;
      document.getElementById('vaultSearch').value = '';
      document.getElementById('showAllVaultsBtn').style.display = 'none';
      renderVaults();
      updateSelectionCount();
    }
    
    function updateSelectionCount() {
      const el = document.getElementById('vaultSelectionCount');
      if (!el) return;
      const searchTerm = document.getElementById('vaultSearch').value.toLowerCase();
      const visibleCount = vaults.filter(v => v.name.toLowerCase().includes(searchTerm) || v.id.toLowerCase().includes(searchTerm)).length;
      const selectedCount = selectedVaultIds.size;
      const items = vaults.filter(v => selectedVaultIds.has(v.id)).reduce((n, v) => n + (v.itemCount || 0), 0);
      document.querySelector('.action-bar').classList.toggle('migrating', isMigrating);
      document.getElementById('statSelected').textContent = selectedCount;
      document.getElementById('statItems').textContent = items.toLocaleString();
      if (isMigrating) return;
      el.textContent = selectedCount === 0 ? 'No vaults selected'
        : `${selectedCount} of ${vaults.length} vault${vaults.length === 1 ? '' : 's'} selected`;
      document.getElementById('selectionHint').textContent =
        (selectedCount === 0 ? 'Pick the vaults to copy to the destination' : `${items.toLocaleString()} item${items === 1 ? '' : 's'} will be copied`) +
        (searchTerm ? ` · ${visibleCount} of ${vaults.length} shown` : '');
      document.querySelectorAll('#vaultTableBody tr[data-vault-id]').forEach(row =>
        row.classList.toggle('selected', selectedVaultIds.has(row.dataset.vaultId)));
    }
    
    function handleVaultSelection(vaultId, itemCount) {
      if (selectedVaultIds.has(vaultId)) {
        selectedVaultIds.delete(vaultId);
        totalItemsToMigrate -= itemCount;
      } else {
        selectedVaultIds.add(vaultId);
        totalItemsToMigrate += itemCount;
      }
      updateSelectAllCheckbox();
      updateSelectionCount();
    }
    
    function toggleSelectAll() {
      const selectAll = document.getElementById('selectAll');
      const checkboxes = document.querySelectorAll('.vault-checkbox:not([disabled])');
      if (selectAll.checked) {
        checkboxes.forEach(cb => {
          if (!selectedVaultIds.has(cb.value)) {
            selectedVaultIds.add(cb.value);
            totalItemsToMigrate += parseInt(cb.dataset.itemCount);
          }
          cb.checked = true;
        });
      } else {
        checkboxes.forEach(cb => {
          if (selectedVaultIds.has(cb.value)) {
            selectedVaultIds.delete(cb.value);
            totalItemsToMigrate -= parseInt(cb.dataset.itemCount);
          }
          cb.checked = false;
        });
      }
      updateSelectionCount();
    }
    
    function updateSelectAllCheckbox() {
      const selectAll = document.getElementById('selectAll');
      const checkboxes = document.querySelectorAll('.vault-checkbox:not([disabled])');
      const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
      selectAll.checked = checkedCount === checkboxes.length && checkboxes.length > 0;
      selectAll.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
    }
    
    function updateVaultStatus(vaultId, status, message, showSpinner = false) {
      const statusBadge = document.getElementById(`status-${vaultId}`);
      if (!statusBadge) return;
      statusBadge.className = `status-badge ${status}`;
      // textContent, so an error message can't inject HTML.
      statusBadge.textContent = showSpinner ? ` ${message}` : message;
      if (showSpinner) {
        const spinner = document.createElement('span');
        spinner.className = 'spinner-small';
        statusBadge.prepend(spinner);
      }
    }
    
    function resetMigrationUI() {
      document.getElementById('progressBar').style.width = '0%';
      document.getElementById('progressPercentage').textContent = '0%';
      document.getElementById('progressLabel').textContent = 'Preparing migration...';
      document.getElementById('vaultsProgress').textContent = '0/0';
      document.getElementById('itemsProgress').textContent = '0/0';
      selectedVaultIds.forEach(vaultId => { updateVaultStatus(vaultId, 'pending', 'Pending'); });
      document.getElementById('migrationSummary').classList.remove('active');
      document.getElementById('alertContainer').innerHTML = '';
      document.getElementById('rateLimitBanner').style.display = 'none';
      hideRatePause();
      Object.keys(rateUsageByLabel).forEach(k => delete rateUsageByLabel[k]);
      document.getElementById('rateUsage').textContent = '';
    }
    
    async function migrateSelected() {
      if (needsReconnect) {
        showAlert('info', 'Connect your accounts again to start another migration.');
        if (usingEnv) autoConnectWithEnv(); else editConnection();
        return;
      }
      if (selectedVaultIds.size === 0) { showAlert('warning', '⚠️ Please select at least one vault to migrate'); return; }
      if (isMigrating) { showAlert('warning', '⚠️ Migration already in progress'); return; }

      
      const alreadyMigrated = [...selectedVaultIds].filter(id => migratedVaultIds.has(id));
      if (alreadyMigrated.length > 0) {
        const names = alreadyMigrated.map(id => {
          const v = vaults.find(v => v.id === id);
          return v ? `"${v.name}"` : id;
        }).join(', ');
        const proceed = confirm(
          `⚠️ Duplicate Migration Warning\n\n` +
          `${alreadyMigrated.length === 1 ? 'This vault was' : 'These vaults were'} already migrated in this session:\n` +
          `${names}\n\n` +
          `Migrating again will create duplicate items in the destination. ` +
          `Are you sure you want to proceed?`
        );
        if (!proceed) return;
      }

      // Show straight away that the click registered: the rate limit check below can take a second.
      setMigrateButtonBusy(true);
      resetMigrationUI();
      showStarting(authMode !== 'desktop' ? 'Checking rate limits...' : 'Starting migration...');

      if (authMode !== 'desktop') {
        const selectedVaultList = vaults.filter(v => selectedVaultIds.has(v.id));
        const checkBody = { vaultItemCounts: selectedVaultList.map(v => v.itemCount), authMode };
        if (usingEnv) checkBody.useEnv = true;
        else checkBody.destToken = destToken;
        try {
          const rlRes = await fetch('/migration/rate-limit-check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(checkBody)
          });
          const rl = await rlRes.json();
          if (rl.success && rl.supported) {
            const banner = document.getElementById('rateLimitBanner');
            const resetText = rl.resetAt ? ` (resets in ${formatDuration(rl.resetAt - Date.now())})` : '';
            if (rl.willPause) {
              const proceed = confirm(
                `⏸ This migration will pause for rate limits\n\n` +
                `It needs up to ~${rl.estimatedWrites.toLocaleString()} writes on the destination service account, ` +
                `and ${rl.available.toLocaleString()} are available right now${resetText}.\n\n` +
                `The migration will pause on its own before it reaches the limit, show a countdown until the limit resets, ` +
                `and continue when you click Resume. Nothing is lost while it's paused.\n\n` +
                `Start the migration?`
              );
              if (!proceed) { stopStarting(); return; }
              banner.style.display = 'block';
              banner.style.background = 'rgba(212, 165, 116, 0.12)';
              banner.style.border = '1px solid var(--accent-warning)';
              banner.style.color = 'var(--accent-warning)';
              banner.textContent = `⏸ Needs up to ~${rl.estimatedWrites.toLocaleString()} destination writes; ${rl.available.toLocaleString()} available now${resetText}. Expect at least one pause.`;
            } else {
              banner.style.display = 'block';
              banner.style.background = 'rgba(91, 155, 213, 0.1)';
              banner.style.border = '1px solid var(--accent-primary)';
              banner.style.color = 'var(--accent-primary)';
              banner.textContent = `📊 Needs up to ~${rl.estimatedWrites.toLocaleString()} destination writes; ${rl.available.toLocaleString()} available now. This should not need a pause.`;
            }
          }
        } catch (e) {
          showAlert('info', '📊 Could not read the rate limits up front. The migration will still pause if it gets close.');
        }
      }
      
      
      document.getElementById('vaultSearch').value = '';
      showSelectedOnly = true;
      document.getElementById('showAllVaultsBtn').style.display = 'inline-flex';
      renderVaults();
      updateSelectionCount();

      isMigrating = true;
      completedVaults = 0;
      processedItems = 0;
      completedItemsFromPriorVaults = 0;
      totalVaultsToMigrate = selectedVaultIds.size;
      
      totalItemsToMigrate = 0;
      vaults.forEach(v => { if (selectedVaultIds.has(v.id)) totalItemsToMigrate += v.itemCount; });
      
      const globalSuffix = document.getElementById('globalSuffix').value.trim();
      const selectedVaults = vaults.filter(v => selectedVaultIds.has(v.id)).map(v => ({ vaultId: v.id, vaultName: v.name, vaultType: v.vaultType || 'shared', itemCount: v.itemCount || 0, suffix: v.suffix || globalSuffix }));
      
      const progressContainer = document.getElementById('progressContainer');
      progressContainer.classList.add('active');
      document.getElementById('progressLabel').textContent = 'Starting migration...';
      document.getElementById('progressPercentage').textContent = '0%';
      document.getElementById('progressBar').style.width = '0%';
      updateProgressStats();
      
      const startPayload = {
        authMode,
        vaults: selectedVaults
      };
      if (usingEnv) {
        startPayload.useEnv = true;
      } else if (authMode === 'desktop') {
        startPayload.sourceAccountName = sourceAccountName;
        startPayload.destAccountName = destAccountName;
      } else {
        startPayload.sourceToken = sourceToken;
        startPayload.destToken = destToken;
      }

      let sessionId;
      try {
        const startRes = await fetch('/migration/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(startPayload)
        });
        const startData = await startRes.json();
        if (!startData.success) {
          showAlert('error', '✗ Failed to start migration session');
          isMigrating = false;
          stopStarting();
          return;
        }
        sessionId = startData.sessionId;
        currentMigrationId = sessionId;
      } catch (e) {
        showAlert('error', '✗ Failed to start migration: ' + e.message);
        isMigrating = false;
        stopStarting();
        return;
      }

      watchMigration(`/migration/migrate-all-vaults?sessionId=${sessionId}`, selectedVaults.length, { fresh: true });
    }

    // Follows a migration's events: a new one (fresh), or one that was already running when the page loaded.
    // Each connection starts its counts from zero, because a reattached stream replays the current state.
    function watchMigration(url, vaultCount, { fresh = false, retries = 3 } = {}) {
      const progressContainer = document.getElementById('progressContainer');
      const migrationId = currentMigrationId;
      let successCount = 0;
      let failureCount = 0;
      let totalItems = 0;
      completedVaults = 0;
      processedItems = 0;
      completedItemsFromPriorVaults = 0;
      setMigrateButtonBusy(true, 'Migrating...');

      const eventSource = new EventSource(url);
      eventSource.onopen = () => {
        if (!fresh) return;
        document.getElementById('progressLabel').textContent = `Migrating ${totalVaultsToMigrate} vaults with ${totalItemsToMigrate} items...`;
        showAlert('info', `🚀 Starting migration of ${totalVaultsToMigrate} vaults...`);
      };
      
      eventSource.onmessage = (event) => {
        const data = JSON.parse(event.data);

        if (data.attached) return;
        if (data.rateLimitEvent) {
          handleRateLimitEvent(data);
          return;
        }
        
        if (data.progress !== undefined && data.outcome) {
          const vaultId = data.outcome.vaultId;
          const phase = data.outcome.phase;
          
          
          if (phase === 'desktop-source-connect' || phase === 'desktop-dest-connect') {
            document.getElementById('progressLabel').textContent = data.outcome.message;
          } else if (phase === 'desktop-reading') {
            document.getElementById('progressLabel').textContent = data.outcome.message;
          } else if (phase === 'desktop-writing') {
            document.getElementById('progressLabel').textContent = data.outcome.message;
          } else if (phase === 'preparing') {
            document.getElementById('progressLabel').textContent = `Preparing vault "${data.outcome.vaultName}"...`;
            updateVaultStatus(vaultId, 'preparing', 'Preparing...', true);
          } else if (phase === 'reading') {
            const read = data.outcome.itemsRead || 0;
            const total = data.outcome.totalItems || 0;
            // the next vault is read while the current one is written: show that on its row only
            if (data.outcome.ahead) {
              updateVaultStatus(vaultId, 'preparing', `Reading ahead (${read}/${total})`, true);
            } else {
              document.getElementById('progressLabel').textContent = `Reading "${data.outcome.vaultName}" from the source (${read}/${total} items)...`;
              updateVaultStatus(vaultId, 'preparing', `Reading (${read}/${total})`, true);
            }
          } else if (phase === 'migrating') {
            const ip = data.outcome.itemsProcessed || 0;
            const ti = data.outcome.totalItems || 0;
            document.getElementById('progressLabel').textContent = data.outcome.activity
              ? `Migrating "${data.outcome.vaultName}" (${ip}/${ti} items): ${data.outcome.activity}`
              : `Migrating "${data.outcome.vaultName}" (${ip}/${ti} items)...`;
            processedItems = completedItemsFromPriorVaults + ip;
            updateVaultStatus(vaultId, 'migrating', `Migrating (${ip}/${ti})`, true);
            updateProgressStats();
          } else if (phase === 'completed') {
            completedVaults++;
            const vaultItemCount = data.outcome.sourceItemCount || 0;
            completedItemsFromPriorVaults += vaultItemCount;
            processedItems = completedItemsFromPriorVaults;
            if (data.outcome.success) {
              migratedVaultIds.add(vaultId);
              updateVaultStatus(vaultId, 'success', `✓ Success (${data.outcome.successCount}/${vaultItemCount})`);
              successCount += data.outcome.successCount || 0;
            } else {
              const fc = data.outcome.failureCount || 0;
              updateVaultStatus(vaultId, fc > 0 ? 'error' : 'warning', `${fc > 0 ? '✗' : '⚠️'} ${fc} failed / ${vaultItemCount} items`);
              failureCount += fc;
              successCount += data.outcome.successCount || 0;
            }
            totalItems += vaultItemCount;
          } else if (phase === 'failed') {
            completedVaults++;
            const vaultItemCount = data.outcome.sourceItemCount || 0;
            completedItemsFromPriorVaults += vaultItemCount;
            processedItems = completedItemsFromPriorVaults;
            updateVaultStatus(vaultId, 'error', `✗ Failed: ${data.outcome.error || 'Unknown error'}`);
            failureCount += vaultItemCount;
          }
          
          updateProgress(data.progress);
          if (phase !== 'migrating') updateProgressStats();
        }
        
        if (data.finished) {
          eventSource.close();
          isMigrating = false;
          currentMigrationId = null;
          hideRatePause();
          
          updateProgress(100);
          setMigrateButtonBusy(false);
          document.getElementById('successCount').textContent = successCount;
          document.getElementById('failureCount').textContent = failureCount;
          document.getElementById('totalItems').textContent = totalItems;
          document.getElementById('totalVaults').textContent = vaultCount;
          document.getElementById('migrationSummary').classList.add('active');
          document.getElementById('progressLabel').textContent = 'Migration complete!';
          
          
          const writes = data.rateLimit?.limits?.find(l => l.scope === 'token' && l.action === 'write');
          if (writes) {
            const banner = document.getElementById('rateLimitBanner');
            banner.style.display = 'block';
            banner.style.background = 'rgba(107, 177, 135, 0.1)';
            banner.style.border = '1px solid var(--accent-success)';
            banner.style.color = 'var(--accent-success)';
            banner.textContent = `✓ Destination service account: ${writes.used.toLocaleString()} of ${writes.limit.toLocaleString()} writes used this hour, ${writes.remaining.toLocaleString()} left` +
              (writes.resetAt ? ` (resets in ${formatDuration(writes.resetAt - Date.now())}).` : '.');
          }

          if (data.gone) {
            showAlert('warning', 'That migration is no longer on the server. Download the logs to see how it went.');
            document.getElementById('migrationSummary').classList.remove('active');
          } else {
            showAlert(data.success ? 'success' : 'warning', `${data.success ? '✓' : '⚠️'} ${data.message}`);
          }
          setTimeout(() => { progressContainer.classList.remove('active'); }, 1500);
          updateSelectionCount();
        }
      };
      
      eventSource.onerror = async () => {
        eventSource.close();
        // Usually a dropped connection, not a failed migration: if the server still has it, follow it again.
        if (retries > 0 && migrationId) {
          await new Promise(r => setTimeout(r, 1000));
          const active = await fetchActiveMigration();
          if (active && active.id === migrationId) {
            watchMigration(`/migration/watch?id=${encodeURIComponent(migrationId)}`, vaultCount, { retries: retries - 1 });
            return;
          }
        }
        isMigrating = false;
        currentMigrationId = null;
        hideRatePause();
        showSelectedOnly = false;
        setMigrateButtonBusy(false);
        showAlert('error', '✗ Migration failed. Please check the logs for details.');
        progressContainer.classList.remove('active');
        renderVaults();
        updateSelectionCount();
      };
    }

    async function fetchActiveMigration() {
      try {
        const res = await fetch('/migration/active');
        return (await res.json()).migration || null;
      } catch { return null; }
    }

    // After a refresh: if the server is still running a migration (or finished one nobody saw), show it.
    async function reattachToRunningMigration() {
      const m = await fetchActiveMigration();
      if (!m) return false;

      authMode = m.authMode || authMode;
      sourceAccountName = m.sourceAccountName || '';
      destAccountName = m.destAccountName || '';
      vaults = m.vaults.map(v => ({ ...v, suffix: '' }));
      showVaultList();
      needsReconnect = true;
      // this page only knows the vaults in this migration, not everything in the source
      document.getElementById('statVaultsLabel').textContent = 'Vaults in this migration';
      document.getElementById('statSourceItemsLabel').textContent = 'Items in this migration';
      vaults.forEach(v => selectedVaultIds.add(v.id));
      showSelectedOnly = true;
      renderVaults();
      updateSelectionCount();

      isMigrating = m.running;
      currentMigrationId = m.id;
      totalVaultsToMigrate = vaults.length;
      totalItemsToMigrate = vaults.reduce((n, v) => n + (v.itemCount || 0), 0);
      const progressContainer = document.getElementById('progressContainer');
      progressContainer.classList.add('active');
      document.getElementById('progressLabel').textContent = 'Catching up with the migration...';
      updateProgressStats();
      showAlert('info', m.running
        ? 'This migration was already running, so the page picked it up again. You can watch, pause or cancel it as before.'
        : 'This migration finished while the page was closed. Here is how it went.');
      watchMigration(`/migration/watch?id=${encodeURIComponent(m.id)}`, vaults.length);
      return true;
    }
    
    
    function formatDuration(ms) {
      const total = Math.max(0, Math.ceil(ms / 1000));
      const h = Math.floor(total / 3600);
      const m = Math.floor((total % 3600) / 60);
      const sec = total % 60;
      const pad = n => String(n).padStart(2, '0');
      return h > 0 ? `${h}:${pad(m)}:${pad(sec)}` : `${m}:${pad(sec)}`;
    }

    function handleRateLimitEvent(data) {
      if (data.rateLimitEvent === 'usage') {
        rateUsageByLabel[data.usage.label] = data.usage;
        renderRateUsage();
      } else if (data.rateLimitEvent === 'paused') {
        showRatePause(data.pause);
      } else if (data.rateLimitEvent === 'checking') {
        document.getElementById('ratePauseCountdown').textContent = 'Checking limits…';
        document.getElementById('rateResumeBtn').disabled = true;
      } else if (data.rateLimitEvent === 'resumed') {
        hideRatePause();
        showAlert('info', '▶ Enough room under the rate limit, migration resumed');
      }
    }

    function renderRateUsage() {
      const el = document.getElementById('rateUsage');
      el.textContent = '';
      for (const usage of Object.values(rateUsageByLabel)) {
        for (const l of usage.limits) {
          const relevant = l.scope === 'account' || (usage.label === 'destination' ? l.action === 'write' : l.action === 'read');
          if (!relevant) continue;
          const span = document.createElement('span');
          const what = l.scope === 'account' ? `${usage.label} account today` : `${usage.label} ${l.action}s this hour`;
          span.textContent = `${what}: ${l.used.toLocaleString()}/${l.limit.toLocaleString()}`;
          if (l.limit > 0 && l.remaining / l.limit < 0.1) span.className = 'near';
          if (el.childNodes.length) el.appendChild(document.createTextNode('  ·  '));
          el.appendChild(span);
        }
      }
    }

    function showRatePause(pause) {
      const panel = document.getElementById('ratePausePanel');
      const detail = document.getElementById('ratePauseDetail');
      const countdown = document.getElementById('ratePauseCountdown');
      const resumeBtn = document.getElementById('rateResumeBtn');

      const windowLabel = pause.scope === 'account' ? 'daily account' : 'hourly';
      const why = pause.reason === 'hit'
        ? `1Password reported the ${pause.label} service account's ${windowLabel} ${pause.kind} limit as reached.`
        : `The ${pause.label} service account is close to its ${windowLabel} ${pause.kind} limit` +
          (pause.limit ? ` (${(pause.limit - (pause.remaining ?? 0)).toLocaleString()} of ${pause.limit.toLocaleString()} used)` : '') + '.';
      detail.textContent = `${why} Nothing has been lost. When the countdown ends, click Resume; the limits are checked again before anything else is sent.`;

      // Count down using the server's clock in case this computer's clock is off.
      const endsAt = Date.now() + (pause.resumeAt - pause.serverTime);
      clearInterval(pauseCountdownTimer);
      resumeBtn.disabled = true;
      resumeBtn.textContent = 'Resume';
      const tick = () => {
        const left = endsAt - Date.now();
        if (left <= 0) {
          clearInterval(pauseCountdownTimer);
          pauseCountdownTimer = null;
          countdown.textContent = 'Ready to resume';
          resumeBtn.disabled = false;
        } else {
          countdown.textContent = `Resume in ${formatDuration(left)}`;
        }
      };
      tick();
      pauseCountdownTimer = setInterval(tick, 1000);

      document.getElementById('progressLabel').textContent = `Paused for rate limits (${pause.label} ${pause.kind}s)`;
      panel.hidden = false;
    }

    function hideRatePause() {
      clearInterval(pauseCountdownTimer);
      pauseCountdownTimer = null;
      document.getElementById('ratePausePanel').hidden = true;
    }

    async function resumeMigration() {
      if (!currentMigrationId) return;
      const resumeBtn = document.getElementById('rateResumeBtn');
      resumeBtn.disabled = true;
      resumeBtn.textContent = 'Checking…';
      try {
        await fetch('/migration/resume', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ migrationId: currentMigrationId })
        });
      } catch (e) {
        resumeBtn.disabled = false;
        resumeBtn.textContent = 'Resume';
        showAlert('error', '✗ Could not reach the server to resume: ' + e.message);
      }
    }

    async function cancelMigration() {
      if (!confirm('Cancel the migration? Items already created in the destination stay there.')) return;
      document.getElementById('rateCancelBtn').disabled = true;
      try {
        await fetch('/migration/cancel', { method: 'POST' });
      } finally {
        document.getElementById('rateCancelBtn').disabled = false;
      }
    }

    // The Migrate Selected button: busy (disabled, with a spinner) from the click until the migration ends.
    function setMigrateButtonBusy(busy, text = 'Starting...') {
      const btn = document.getElementById('migrateSelectedBtn');
      btn.disabled = busy;
      btn.textContent = busy ? ` ${text}` : 'Migrate Selected';
      if (busy) {
        const spinner = document.createElement('span');
        spinner.className = 'spinner';
        spinner.style.cssText = 'width:14px;height:14px;vertical-align:-2px;';
        btn.prepend(spinner);
      }
    }

    function showStarting(message) {
      document.getElementById('progressContainer').classList.add('active');
      document.getElementById('progressLabel').textContent = message;
      updateProgress(0);
    }

    // The migration didn't start after all (cancelled at a prompt, or the server said no).
    function stopStarting() {
      setMigrateButtonBusy(false);
      document.getElementById('progressContainer').classList.remove('active');
    }

    function updateProgress(percentage) {
      document.getElementById('progressBar').style.width = `${percentage}%`;
      document.getElementById('progressPercentage').textContent = `${Math.round(percentage)}%`;
      document.getElementById('actionProgressBar').style.width = `${percentage}%`;
      if (isMigrating) {
        document.getElementById('vaultSelectionCount').textContent =
          `Migrating ${totalVaultsToMigrate} vault${totalVaultsToMigrate === 1 ? '' : 's'} · ${Math.round(percentage)}%`;
      }
    }

    // Keeps the search bar and column headings on screen while a long vault list scrolls, and shows
    // the progress text in the bottom bar so it's visible from anywhere on the page.
    function initStickyToolbar() {
      const toolbar = document.querySelector('.toolbar');
      new ResizeObserver(() => document.documentElement.style.setProperty('--toolbar-h', `${toolbar.offsetHeight}px`)).observe(toolbar);
      new MutationObserver(() => {
        if (isMigrating) document.getElementById('selectionHint').textContent = document.getElementById('progressLabel').textContent;
      }).observe(document.getElementById('progressLabel'), { childList: true, characterData: true, subtree: true });
    }
    
    function updateProgressStats() {
      document.getElementById('vaultsProgress').textContent = `${completedVaults}/${totalVaultsToMigrate}`;
      document.getElementById('itemsProgress').textContent = `${Math.round(processedItems)}/${totalItemsToMigrate}`;
    }
    
    async function downloadLogs() {
      try { window.location.href = '/migration/download-log'; showAlert('success', '📥 Log file downloaded successfully'); }
      catch (error) { showAlert('error', '✗ Failed to download logs'); }
    }
    
    function showAlert(type, message, duration = null) {
      const container = document.getElementById('alertContainer');
      const alertDiv = document.createElement('div');
      alertDiv.className = `alert alert-${type}`;
      const icon = type === 'success' ? '✓' : type === 'error' ? '✕' : type === 'warning' ? '!' : 'i';
      const iconSpan = document.createElement('span');
      iconSpan.className = 'alert-icon';
      iconSpan.textContent = icon;
      const msgSpan = document.createElement('span');
      msgSpan.textContent = String(message).replace(/^[^\p{L}\p{N}"'(<]+/u, '');
      alertDiv.appendChild(iconSpan);
      alertDiv.appendChild(msgSpan);
      container.appendChild(alertDiv);
      const timeout = duration || (type === 'info' ? 10000 : 5000);
      setTimeout(() => { alertDiv.style.opacity = '0'; setTimeout(() => alertDiv.remove(), 300); }, timeout);
    }
    
    function escapeHtml(text) {
      return String(text ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }
  </script>
</body>
</html>
